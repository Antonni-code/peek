{
  "name": "peek-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preview links without leaving the page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.35.0",
    "@types/chrome": "^0.1.1",
    "@types/jsdom": "^21.1.7",
    "@types/picomatch": "^4.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "type-fest": "^4.41.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
    ,"wrangler": "^4.38.0"
  }
}
